# ---------------------------------------------------------------------------
# Model checkpoints -- large binaries, reproducible from the run scripts
# ---------------------------------------------------------------------------
models/
*.safetensors

# ---------------------------------------------------------------------------
# Raw and processed data -- reproducible via the build_*_splits.py scripts
# ---------------------------------------------------------------------------
*.parquet
experiments/portable/full_dataset/daigt.csv
experiments/portable/full_dataset/hc3.jsonl

# ---------------------------------------------------------------------------
# Prediction arrays and split indices for the live runs.
# Regeneratable from the checkpoints. The archived copies under archive/ and
# the audit arrays under experiments/audit/ stay tracked on purpose, because
# the checkpoints that produced them no longer exist.
# ---------------------------------------------------------------------------
experiments/midterm/probs/*.npz
experiments/midterm/work/*.npz
experiments/paper_scale/probs/*.npz
experiments/paper_scale/work/*.npz

# ---------------------------------------------------------------------------
# Large archives -- submission bundles live in archive/submissions/
# ---------------------------------------------------------------------------
*.zip

# ---------------------------------------------------------------------------
# Transient control files and scratch backups
# ---------------------------------------------------------------------------
experiments/paper_scale/.nlp.stop

# ---------------------------------------------------------------------------
# Python cache
# ---------------------------------------------------------------------------
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.DS_Store

# ---------------------------------------------------------------------------
# LaTeX build artifacts (paper/iccit/); main.bbl is kept deliberately
# ---------------------------------------------------------------------------
paper/iccit/*.aux
paper/iccit/*.log
paper/iccit/*.out
paper/iccit/*.blg
paper/iccit/*.fdb_latexmk
paper/iccit/*.fls
paper/iccit_profstyle/*.aux
paper/iccit_profstyle/*.log
paper/iccit_profstyle/*.out
paper/iccit_profstyle/*.blg
paper/iccit_profstyle/*.fdb_latexmk
paper/iccit_profstyle/*.fls
paper/iccit_profstyle/.build-manifest

# Material belonging to a different project, dropped in here by hand
All Outputs_Plot_from_another_project\ /

# Supervisor's own reference paper (style template only) -- not our IP,
# contains other students' names/emails/IDs, never publish this.
ICCIT_2026___Surface_Content___Arnob__Niloy/
ICCIT_2026___Surface_Content___Arnob__Niloy.zip

# FUSE leaves these behind when a file is deleted while still open, e.g. by LibreOffice
.fuse_hidden*

\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-A}}A classical model matches a transformer on DAIGT V2 but not on HC3}{3}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces ROC curves for all eight model configurations, restricted to the low-false-positive region where the models actually differ. Areas under the full curve are given in the legend. On DAIGT V2 (a) every configuration converges toward the corner and the classical models are close behind the transformers. On HC3 (b) the two transformers separate sharply from all six classical configurations. Colours are colourblind-safe and each series carries a distinct dash pattern, so the ordering survives greyscale reproduction.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:roc}{{1}{4}{ROC curves for all eight model configurations, restricted to the low-false-positive region where the models actually differ. Areas under the full curve are given in the legend. On DAIGT V2 (a) every configuration converges toward the corner and the classical models are close behind the transformers. On HC3 (b) the two transformers separate sharply from all six classical configurations. Colours are colourblind-safe and each series carries a distinct dash pattern, so the ordering survives greyscale reproduction}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-B}}On HC3, orthography alone matches content alone}{4}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Surface-content decomposition. Surface-only uses 47 orthographic features and never reads a word. Content-only is unfiltered bag-of-words after punctuation, casing and non-ASCII are stripped. The lower block closes the document-length channel that both primary arms can otherwise read. Bold marks the better arm in each block and dataset column. The transformer is a reference point, not a matched arm.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:decomp}{{II}{4}{Surface-content decomposition. Surface-only uses 47 orthographic features and never reads a word. Content-only is unfiltered bag-of-words after punctuation, casing and non-ASCII are stripped. The lower block closes the document-length channel that both primary arms can otherwise read. Bold marks the better arm in each block and dataset column. The transformer is a reference point, not a matched arm}{table.2}{}}
